/*
 * -----------------------------------------------
 *  University of Hawaii at Manoa HPCC config file
 * -----------------------------------------------
 *
 */

singularity {
    enabled = true
    cacheDir = "/mnt/lustre/koa/lab/cmaiki_group/cmaiki_v2_apps/singularity_images.cache"
}

executor {
    queueSize = 40
    jobName = {"${task.process.tokenize(':')[-1]}.${task.tag}"}
}

process {
    executor = "slurm"
    queue = "shared,kill-shared,kill-exclusive"

    resourceLimits = [cpus: 40, memory: 1000.GB, time: 72.h]

    withName: DADA2_ADDSPECIES {
        cpus = 1
        memory = { [120.GB, 240.GB, 480.GB, 850.GB][Math.min(task.attempt, 4) - 1] }
        time = 24.h
    }

    withName: QIIME2_CLASSIFY {
        cpus = 20
        memory = { [120.GB, 240.GB, 480.GB, 850.GB][Math.min(task.attempt, 4) - 1] }
    }

    withName: QIIME2_SEQFILTERTABLE {
        tag = "tag_without_white_space"
    }
}
