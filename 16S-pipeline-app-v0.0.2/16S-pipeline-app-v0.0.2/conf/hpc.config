/*
 * -----------------------------------------------
 *  University of Hawaii at Manoa HPCC config file
 * -----------------------------------------------
 *
 */


singularity {
    enabled = true
    cacheDir = "/mnt/lustre/koa/lab/cmaiki_group/cmaiki_v2_apps/singularity_images.cache"
}

executor {
    jobName = {"$task.tag"}
    queueSize = 40
}

process {
    executor = 'slurm'
    queue = 'shared,kill-shared,kill-exclusive'

    errorStrategy = 'retry'
    maxRetries = 2

    withLabel: low_computation {
        cpus = 4
        memory = { [8.GB, 16.GB, 32.GB][task.attempt - 1] }
        time = { [4.h, 8.h, 16.h][task.attempt - 1] }
    }

    withLabel: medium_computation {
        cpus = 8
        memory = { [24.GB, 48.GB, 96.GB][task.attempt - 1] }
        time = { [4.h, 8.h, 16.h][task.attempt - 1] }
    }

    withLabel: high_computation {
        cpus = 8
        memory = { [64.GB, 120.GB, 240.GB][task.attempt - 1] }
        time = { [8.h, 16.h, 24.h][task.attempt - 1] }
    }

    withLabel: highmem_computation {
        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 4
        cpus = 8
        memory = { [64.GB, 120.GB, 240.GB, 480.GB, 850.GB][task.attempt - 1] }
        time = 8.h
    }

    withName: Lulu {
        time = { [8.h, 16.h, 24.h][task.attempt - 1] }
    }
}
