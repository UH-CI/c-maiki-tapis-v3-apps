/*
 * -------------------------------------------------
 *  Singularity config file
 * -------------------------------------------------
 * 
 */

params.script_dir = "/workspace" 

env {
    PYTHONPATH = "/workspace" + ":${PYTHONPATH}"
}

singularity {
   enabled = false
   cacheDir = "/mnt/lustre/koa/lab/cmaiki_group/cmaiki_v2_apps/singularity_images.cache"
}

docker {
   enabled = false
   fixOwnership = true
   sudo = true
}

process {
   container = 'nakor/pipeline-env:1.1'
   stageInMode = 'rellink'
   stageOutMode = 'rsync'   
}	

process {
   withLabel: mothur_script {container = 'nakor/pipeline-env-mothur:1.44'}
   withName: QcFilter {container = 'alexcoppe/fastx'}
   withName: FastTree {container = 'pegi3s/fasttree'}
}
