/*
 * -----------------------------------------------
 *  University of Hawaii at Manoa HPCC config file
 * -----------------------------------------------
 *
 */

singularity {
    enabled = true
    cacheDir = "/mnt/lustre/koa/lab/cmaiki_group/cmaiki_v2_apps/singularity_images.cache"
}

executor {
    jobName = {"${task.process.tokenize(':')[-1]}.${task.tag}"}
    queueSize = 40
}

process {
    executor = "slurm"
    queue = "shared,kill-shared,kill-exclusive"
    errorStrategy = "retry"
    maxErrors = "-1"

    withLabel: process_low {
        maxRetries = 2
        cpus = 4
        memory = { [8.GB, 16.GB, 64.GB][task.attempt - 1] }
        time = { [4.h, 8.h, 16.h][task.attempt - 1] }
    }
    withLabel: process_medium {
        maxRetries = 2
        cpus = 8
        memory = { [24.GB, 48.GB, 96.GB][task.attempt - 1] }
        time = { [4.h, 8.h, 16.h][task.attempt - 1] }
    }
    withLabel: process_high {
        maxRetries = 2
        queue = "shared"
        cpus = 8
        memory = { [16.GB, 32.GB, 64.GB][task.attempt - 1] }
        time = { [4.h, 8.h, 16.h][task.attempt - 1] }
    }
    withLabel: 'plot' {
        errorStrategy = "ignore"        
    }
    withName: 'FAST_TREE|PHYLOSEQ_UNIFRAC|LULU' {
         errorStrategy = "ignore"
    }
}
